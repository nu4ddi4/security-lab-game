    {
      "id": "not-yet-running",
      "steps": [
        {
          "command": "pause T-17",
          "device": "server_console",
          "code": "TASK_NOT_RUNNING"
        },
        {
          "command": "logs access --task T-17",
          "device": "server_console",
          "code": "NO_RECORDS"
        },
        {
          "command": "verify search",
          "device": "server_console",
          "code": "WRONG_DEVICE"
        },
        {
          "command": "logs submissions",
          "device": "control_console",
          "code": "PERMISSION_REQUIRED"
        }
      ]
    },
    {
      "id": "day-end-needs-work",
      "steps": [
        {
          "action": {
